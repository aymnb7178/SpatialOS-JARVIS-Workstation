# Safe template. Never commit real keys to Git.
#
# IMPORTANT: the application reads REAL environment variables (os.environ).
# It does NOT load this file automatically. Export the values in your shell, e.g.
#   Linux / macOS :  export OPENAI_API_KEY="your-key"
#   PowerShell    :  $env:OPENAI_API_KEY = "your-key"
# or load this file yourself with a tool of your choice.
#
# All variables are optional. Without a key the project runs in local mode.

# Used by UnifiedModelGateway (OpenAI chat completions endpoint).
OPENAI_API_KEY=

# Only detected by the system-awareness report. No Gemini API calls are made by this code.
GEMINI_API_KEY=

# Model names used by UnifiedModelGateway when OPENAI_API_KEY is set.
JARVIS_FAST_MODEL=gpt-4o-mini
JARVIS_REASONING_MODEL=gpt-4o
